# Kittum reads its settings from the environment (kittum/apps/server/src/kittum/settings.py).
# Copy this file to .env, adjust, and load it before `kittum serve`, `kittum worker`, or
# `kittum demo seed`, e.g. `set -a; . ../../.env; set +a` in apps/server. Relative paths are
# relative to apps/server, where those commands run.

# Postgres 18, migrated with dbmate (see README.md, "Run Kittum").
KITTUM_DATABASE_URL=postgresql://kittum:kittum@127.0.0.1:55432/kittum

# Content-addressed artifact store: PDFs, raw responses, model outputs, parsed layers. It belongs
# with its database: point every process of one deployment at the same directory, and never pair
# a database with another store.
KITTUM_ARTIFACT_DIR=.kittum/artifacts

# The open sources the worker enriches the corpus from, and fetches open-access full texts with.
# A contact address puts Kittum in Crossref's polite pool (10 requests per second instead of 5)
# and NCBI's, and Unpaywall answers only requests that carry one: without it, enrichment skips
# Unpaywall. It goes to those services in each request, so use an address meant for it.
KITTUM_CONTACT_EMAIL=
# Optional keys: NCBI's raises PubMed from 3 to 10 requests per second; OpenAlex's gives this
# deployment its own daily budget instead of one shared by everyone on the same IP address.
KITTUM_NCBI_API_KEY=
KITTUM_OPENALEX_API_KEY=
# Offline mode, for the end-to-end stack and demos without a network: KITTUM_OFFLINE=1 together
# with a directory of recorded source responses (apps/server/tests/enrich/fixtures/stack). The
# gateway then answers from the recordings, never touches the network, and caches in memory, not in
# the deployment's response cache. A request that was never recorded fails as an unreachable source
# would. Kittum refuses to start with one of the two and not the other. Leave both empty to go live.
KITTUM_OFFLINE=
KITTUM_GATEWAY_RECORDINGS=

# Model servers, as recipe=URL pairs separated by commas. Recipe IDs come from
# apps/server/src/kittum/models/recipes.yaml or KITTUM_RECIPES_FILE. Ollama on a laptop:
KITTUM_LLM_ENDPOINTS=qwen3.5-4b-ollama=http://127.0.0.1:11434/v1
# Your own recipes, in the format of recipes.yaml, added to the shipped ones (a local ID may not
# reuse a shipped one; the weights licence allowlist applies). Hosted APIs go here. Keep the file
# under .kittum/, which git ignores. See README.md, "Run Kittum".
KITTUM_RECIPES_FILE=
# API keys for hosted endpoints, as recipe=VARIABLE pairs: the name of the environment variable
# that holds the key, never the key. Kittum reads it for each call, sends it as a bearer token, and
# stores it nowhere. Export the variable in your shell, not in this file.
KITTUM_LLM_API_KEYS=
# The screening judge: one of the recipes above (default: the first). Any recipe may judge, hosted
# ones included: which records go to which model is your decision, and the AI disclosure records
# the recipe, its serving, and the endpoint.
KITTUM_JUDGE_MODEL=qwen3.5-4b-ollama
# `endpoint` calls the model server above; `demo` replays the demo project's recorded answers
# (for the end-to-end test, or a demo without a model server). `kittum serve` and `kittum worker`
# must agree: a worker refuses the jobs of a stage that names another judge.
KITTUM_JUDGE_BACKEND=endpoint

# The built workbench (`pnpm build` writes apps/web/dist). With it, `kittum serve` serves the API
# and the workbench from one process; `kittum serve --web-dist` does the same.
KITTUM_WEB_DIST=../web/dist

# Ed25519 key that signs ledger checkpoints and bundles (optional for the demo):
# openssl genpkey -algorithm ed25519 -out checkpoint.pem
KITTUM_CHECKPOINT_KEY=

# GROBID for document metadata (optional, not used by the demo).
KITTUM_GROBID_URL=
