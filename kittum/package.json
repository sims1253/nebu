{
  "name": "kittum",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev:web": "vp run --filter @kittum/web dev",
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "knip": "knip",
    "contracts:generate": "vp run --filter @kittum/contracts generate",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip && pnpm build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.15.0"
}
