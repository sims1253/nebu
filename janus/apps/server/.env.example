# Janus server runtime configuration.
# Copy to `.env` to activate. `.env` is gitignored.
#
# Uploads and artifacts default to ~/.janus/ so they survive restarts.
# JANUS_DATA_DIR moves every default root at once; the variables below
# override individual roots. Review metadata is durable only with the
# sqlite store (see JANUS_REVIEW_STORE).

# Logging level for the server (DEBUG | INFO | WARNING | ERROR).
JANUS_LOG_LEVEL=INFO

# Review metadata store: memory (default, lost on restart) | sqlite
# (persists across restarts). Use sqlite for any real workflow.
JANUS_REVIEW_STORE=sqlite
# SQLite database location (only used with JANUS_REVIEW_STORE=sqlite).
# JANUS_REVIEW_DB_PATH=~/.janus/reviews-v2.sqlite3

# Root directory for persisted review artifacts (plans, evidence,
# extractions, results).
# JANUS_ARTIFACT_DIR=~/.janus/artifacts

# Root directory for uploaded review inputs.
# JANUS_UPLOAD_DIR=~/.janus/uploads/reviews
